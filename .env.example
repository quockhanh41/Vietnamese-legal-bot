# ─────────────────────────────────────────────────────────────────────────
# Vietnamese Legal Knowledge Bot — environment configuration
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# ─────────────────────────────────────────────────────────────────────────

# ── LLM (Groq primary, via LiteLLM) ──────────────────────────────────────
# Generation + classification run on Groq (Qwen 3 32B).
# Provide EITHER a single key, OR a comma-separated list of keys that the
# gateway rotates through on rate-limit errors (free-tier friendly).
# GROQ_API_KEYS takes precedence over GROQ_API_KEY when both are set.
# NOTE: Groq's tokens-per-day cap is per-ORGANIZATION — multiple keys from
# the same org share one daily bucket; only keys from different orgs add
# real capacity.
GROQ_API_KEY=gsk_your_groq_key_here
# GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3

# ── LLM cross-provider fallbacks ($0, optional but recommended) ──────────
# Used in order when Groq's daily budget runs dry (see MODEL_CHAIN in
# src/llm/gateway.py). Leave empty to skip — the chain drops keyless steps.
# Each provider supports the same rotation pattern as Groq: *_API_KEYS
# (comma-separated, rotated on rate-limit, takes precedence) or *_API_KEY.
# Unlike Groq, Gemini/OpenRouter free quotas are per-account — keys from
# different accounts DO add real capacity.
# Gemini: https://aistudio.google.com/apikey (gemini-3.5-flash free tier)
GEMINI_API_KEY=
# GEMINI_API_KEYS=key1,key2
# OpenRouter: https://openrouter.ai/settings/keys (:free models,
# ~50 requests/day per account unless you've topped up $10 once)
OPENROUTER_API_KEY=
# OPENROUTER_API_KEYS=key1,key2
# OpenAI (paid, last resort — gpt-4o-mini)
OPENAI_API_KEY=

# ── Vector store (Qdrant) ────────────────────────────────────────────────
# Qdrant Cloud: set both. For a local instance (`make qdrant`) use
# QDRANT_URL=http://localhost:6333 and leave QDRANT_API_KEY empty.
QDRANT_URL=https://your-cluster-id.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here

# ── Confidence gate (optional override) ──────────────────────────────────
# Refusal threshold for the 5-signal confidence score. Calibrated default is
# 0.725 (see src/rag/confidence.py); override per-deployment if needed.
# CONFIDENCE_REFUSAL_THRESHOLD=0.725

# ── UI → API wiring ──────────────────────────────────────────────────────
# Base URL the Streamlit UI uses to reach the FastAPI backend.
# Local default is http://localhost:8000; docker-compose sets http://api:8000.
# API_URL=http://localhost:8000

# ── Redis (reserved; used by docker-compose, not yet wired into the app) ──
# REDIS_URL=redis://localhost:6379
